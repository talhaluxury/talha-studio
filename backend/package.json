{
  "name": "talha-studio-api",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "seed:admin": "tsx --env-file=.env src/seedAdmin.ts",
    "cleanup:orphans": "tsx --env-file=.env src/cleanupOrphans.ts",
    "seed:demo": "tsx --env-file=.env src/seedDemo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "argon2": "^0.40.3",
    "fastify": "^5.12.7",
    "google-auth-library": "^9.14.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^4.6.7",
    "@aws-sdk/client-s3": "^3.620.0",
    "@fastify/multipart": "^9.0.0",
    "sharp": "^0.35.5",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@types/nodemailer": "^8.0.2"
  }
}
