# Copy to .env (never commit). On the host, set these as secrets.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://user:password@host:5432/talha
JWT_ACCESS_SECRET=change-me-long-random
GOOGLE_WEB_CLIENT_ID=
# Comma-separated. Include the Android admin app origin as well as your website, if you host one:
ADMIN_ORIGIN=https://appassets.androidplatform.net,https://admin.example.com
STORAGE_DRIVER=local         # local (dev only) | s3 (Cloudflare R2 / Backblaze B2 / MinIO)
LOCAL_MEDIA_DIR=./media
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_MEDIA_BASE_URL=

# First owner account (run `npm run seed:admin` once, then delete the password from the host)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Shipping: INITIAL values only. After first launch the owner edits them in the admin panel (Store settings). FREE_SHIPPING_OVER_PKR=0 disables free shipping.
SHIPPING_FLAT_PKR=299
FREE_SHIPPING_OVER_PKR=0
MAX_COD_ORDER_PKR=200000
RETURN_WINDOW_DAYS=7
STORE_TIMEZONE=Asia/Karachi

# --- Email (Phase 6). EMAIL_DRIVER=none keeps emails queued (nothing is sent, nothing is lost).
EMAIL_DRIVER=none            # none | resend | smtp
EMAIL_FROM="Talha Studio <orders@yourdomain.com>"   # must be a sender/domain verified with your provider
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=       # whsec_... from Resend > Webhooks (enables "delivered/bounced" confirmation)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CRON_SECRET=                 # long random string; an external pinger calls POST /v1/internal/email/run with header x-cron-secret
ADMIN_PUBLIC_URL=            # e.g. https://admin.yourdomain.com  (adds an "Open in admin" link to the owner email)
PUBLIC_LOGO_URL=             # optional https URL of the logo to show in emails
STORE_NAME=Talha Studio

# --- Push (Phase 7). Leave empty to disable push; the in-app notification inbox still works.
FCM_SERVICE_ACCOUNT_JSON=    # paste the whole Firebase service-account JSON as ONE host secret (never commit it)

# --- Hardening (Phase 9)
TRUST_PROXY_HOPS=1           # reverse proxies in front of the API (Render = 1; Cloudflare in front of Render = 2)
MAX_OPEN_ORDERS_PER_USER=5   # abuse guard: pending/confirmed/processing orders one customer may have at once
ALLOW_LOCAL_STORAGE=0        # production refuses STORAGE_DRIVER=local unless this is 1 (only for a persistent disk)
